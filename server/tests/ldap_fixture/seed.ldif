# Тестовый каталог: @USER_PASSWORD@ подставляет run.sh (случайный на каждый прогон).
# Вложенность: alice ∈ engineers ∈ vpn-users; цикл loop-a ⇄ loop-b для проверки защиты от зацикливания.

dn: ou=people,dc=example,dc=org
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=example,dc=org
objectClass: organizationalUnit
ou: groups

dn: uid=alice,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
uid: alice
cn: Alice Example
sn: Example
displayName: Alice Example
mail: alice@example.org
mobile: +1 555 0100
userPassword: @USER_PASSWORD@

dn: uid=bob,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
uid: bob
cn: Bob Example
sn: Example
mail: bob@example.org
userPassword: @USER_PASSWORD@

dn: cn=engineers,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: engineers
member: uid=alice,ou=people,dc=example,dc=org

dn: cn=vpn-users,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: vpn-users
member: cn=engineers,ou=groups,dc=example,dc=org

dn: cn=staff,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: staff
member: uid=bob,ou=people,dc=example,dc=org

dn: cn=loop-a,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: loop-a
member: uid=alice,ou=people,dc=example,dc=org
member: cn=loop-b,ou=groups,dc=example,dc=org

dn: cn=loop-b,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: loop-b
member: cn=loop-a,ou=groups,dc=example,dc=org
