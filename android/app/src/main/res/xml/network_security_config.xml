<?xml version="1.0" encoding="utf-8"?>
<!-- Рабочая сборка: только HTTPS и только системные центры сертификации (пользовательские CA для фактора аутентификации не принимаются). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
