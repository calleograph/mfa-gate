<?xml version="1.0" encoding="utf-8"?>
<!-- Только отладочная сборка: тестовый стенд по HTTP и сертификаты пользовательских CA. В рабочей сборке открытый HTTP запрещён целиком. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
