# Разрешённое для scripts/check_private_data.py. Формат: <вид> <значение>; # — комментарий.
#   domain   — домен и все его поддомены (только публичные сервисы и стандарты, не адреса организаций)
#   email    — конкретный адрес
#   ip       — адрес или сеть (документационные и частные диапазоны разрешены в самом сканере)
#   key-file — glob файлов, где допустим закрытый ключ (только тестовые фикстуры)
#   skip     — glob файлов, которые не проверяются целиком
# example.org/com/net, *.example, *.test, *.invalid, localhost разрешены всегда.

# Сам сканер и этот список содержат образцы шаблонов
skip scripts/check_private_data.py
skip scripts/private-data.allow
# Тексты лицензий
skip LICENSE
skip */OFL.txt
skip */LICENSE-*.txt

# Стандарты и спецификации
domain apache.org
domain w3.org
domain ietf.org
domain rfc-editor.org
domain iana.org
domain owasp.org
domain keepachangelog.com
domain semver.org
domain schemastore.org
domain json-schema.org
domain openapis.org
domain swagger.io

