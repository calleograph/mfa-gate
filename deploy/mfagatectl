#!/usr/bin/env bash
# Управление экземпляром MFA Gate: установка, обновление, откат, резервные копии, диагностика.
# Все команды идемпотентны там, где это возможно; любая ошибка — понятное сообщение и ненулевой код.
set -Eeuo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${MFA_GATE_ENV_FILE:-$HERE/.env}"
COMPOSE_FILE="$HERE/compose.yml"

say()  { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33mWARN\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[31mFAIL\033[0m %s\n' "$*" >&2; exit 1; }

load_env() {
  [[ -f "$ENV_FILE" ]] || die "нет $ENV_FILE — сначала ./mfagatectl install"
  set -a; # shellcheck disable=SC1090
  . "$ENV_FILE"; set +a
  cd "$HERE"
  DATA="$(cd "$HERE" && realpath -m "${MFA_GATE_DATA:-./data}")"
  BACKUPS="$(cd "$HERE" && realpath -m "${MFA_GATE_BACKUPS:-./backups}")"
}

# compose.override.yml рядом с compose.yml — локальные дополнения экземпляра (файл FCM, переменные HMS), в Git не хранится
OVERRIDE_FILE="$HERE/compose.override.yml"
dc() {
  local files=(-f "$COMPOSE_FILE"); [[ -f "$OVERRIDE_FILE" ]] && files+=(-f "$OVERRIDE_FILE")
  docker compose --project-directory "$HERE" --env-file "$ENV_FILE" "${files[@]}" -p "$COMPOSE_PROJECT_NAME" "$@"
}

set_env() {   # set_env KEY VALUE — заменить или добавить строку в .env
  local key="$1" value="$2"
  if grep -q "^${key}=" "$ENV_FILE"; then
    sed -i "s|^${key}=.*|${key}=${value}|" "$ENV_FILE"
  else
    printf '%s=%s\n' "$key" "$value" >> "$ENV_FILE"
  fi
}

valid_version() { [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || die "версия должна быть вида 1.2.3, получено: $1"; }

preflight() {
  command -v docker >/dev/null || die "Docker не установлен"
  docker info >/dev/null 2>&1 || die "Docker недоступен текущему пользователю (группа docker или sudo)"
  docker compose version >/dev/null 2>&1 || die "нет плагина docker compose v2"
}

port_free() {   # port_free BIND PORT PROTO
  local proto_flag=-ltn; [[ "$3" == udp ]] && proto_flag=-lun
  ! ss -H "$proto_flag" "sport = :$2" 2>/dev/null | grep -q .
}

wait_healthy() {   # ждём healthy у api/radius/worker
  local deadline=$((SECONDS + ${1:-120})) svc state all_ok
  while (( SECONDS < deadline )); do
    all_ok=1
    for svc in api radius worker; do
      state="$(docker inspect -f '{{.State.Health.Status}}' "$(dc ps -q "$svc" 2>/dev/null)" 2>/dev/null || echo missing)"
      [[ "$state" == healthy ]] || all_ok=0
    done
    (( all_ok )) && return 0
    sleep 3
  done
  return 1
}

ensure_image() {
  if [[ "$MFA_GATE_IMAGE" == */* ]]; then
    say "загрузка образа $MFA_GATE_IMAGE:$MFA_GATE_VERSION"
    if dc pull --quiet migrate api radius worker postgres; then return 0; fi
    # нет доступа к реестру или версия ещё не опубликована — собираем тот же тег из исходников этого каталога
    [[ "${MFA_GATE_NO_BUILD:-}" == 1 ]] && die "не удалось загрузить образ $MFA_GATE_IMAGE:$MFA_GATE_VERSION"
    [[ -f "$HERE/../server/Dockerfile" ]] || die "образ $MFA_GATE_IMAGE:$MFA_GATE_VERSION недоступен, исходников для сборки нет"
    warn "образ не загружен — сборка из исходников (несколько минут)"
  else
    say "локальная сборка образа $MFA_GATE_IMAGE:$MFA_GATE_VERSION"
  fi
  dc build migrate || die "сборка образа не удалась"
  docker image inspect postgres:16-alpine >/dev/null 2>&1 || dc pull --quiet postgres || die "не удалось загрузить образ PostgreSQL"
}

cmd_install() {
  preflight
  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$HERE/.env.example" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    set_env POSTGRES_PASSWORD "$(openssl rand -hex 24)"
    [[ -n "${MFA_GATE_PUBLIC_URL:-}" ]] && set_env MFA_GATE_PUBLIC_URL "$MFA_GATE_PUBLIC_URL"
    [[ -n "${MFA_GATE_HTTP_PORT:-}" ]] && set_env MFA_GATE_HTTP_PORT "$MFA_GATE_HTTP_PORT"
    [[ -n "${MFA_GATE_RADIUS_PORT:-}" ]] && set_env MFA_GATE_RADIUS_PORT "$MFA_GATE_RADIUS_PORT"
    [[ -n "${MFA_GATE_IMAGE:-}" ]] && set_env MFA_GATE_IMAGE "$MFA_GATE_IMAGE"
    [[ -n "${COMPOSE_PROJECT_NAME:-}" ]] && set_env COMPOSE_PROJECT_NAME "$COMPOSE_PROJECT_NAME"
    say "создан $ENV_FILE (проверьте MFA_GATE_PUBLIC_URL, порты и образ, затем повторите install)"
    # без явно переданного адреса останавливаемся: ставить систему с примерами из .env.example нельзя
    [[ -n "${MFA_GATE_PUBLIC_URL:-}" ]] || return 0
  fi
  load_env
  grep -q '^POSTGRES_PASSWORD=.\+' "$ENV_FILE" || set_env POSTGRES_PASSWORD "$(openssl rand -hex 24)"
  load_env
  [[ "$MFA_GATE_PUBLIC_URL" == *example.org* ]] && warn "MFA_GATE_PUBLIC_URL оставлен примером — исправьте в .env до привязки телефонов"
  mkdir -p "$DATA/postgres" "$DATA/secrets" "$BACKUPS"
  chmod 700 "$DATA/secrets" "$BACKUPS"
  if [[ ! -s "$DATA/secrets/master.key" ]]; then
    openssl rand -base64 32 > "$DATA/secrets/master.key"
    # каталог 0700 защищает ключ на хосте; сам файл читаем процессом контейнера (uid 10001)
    chmod 644 "$DATA/secrets/master.key"
    say "сгенерирован мастер-ключ $DATA/secrets/master.key — СОХРАНИТЕ ЕГО КОПИЮ ОТДЕЛЬНО: без него резервные копии бесполезны"
  fi
  if [[ -z "$(dc ps -q api 2>/dev/null)" ]]; then
    port_free "$MFA_GATE_HTTP_BIND" "$MFA_GATE_HTTP_PORT" tcp || die "порт $MFA_GATE_HTTP_PORT/tcp занят — задайте MFA_GATE_HTTP_PORT в .env"
    port_free "$MFA_GATE_RADIUS_BIND" "$MFA_GATE_RADIUS_PORT" udp || die "порт $MFA_GATE_RADIUS_PORT/udp занят — задайте MFA_GATE_RADIUS_PORT в .env"
  fi
  ensure_image
  say "запуск (миграции выполняются сервисом migrate перед стартом api/radius/worker)"
  dc up -d || die "контейнеры не запустились: ./mfagatectl logs"
  wait_healthy 180 || die "сервисы не стали healthy за 3 мин: ./mfagatectl status; ./mfagatectl logs"
  say "готово: панель http://$MFA_GATE_HTTP_BIND:$MFA_GATE_HTTP_PORT (снаружи — через reverse proxy на $MFA_GATE_PUBLIC_URL)"
  say "первый администратор: ./mfagatectl admin <логин>"
}

cmd_status() {
  load_env
  dc ps --format 'table {{.Service}}\t{{.Status}}\t{{.Ports}}'
  printf '\nверсия: %s, образ: %s\n' "$MFA_GATE_VERSION" "$MFA_GATE_IMAGE"
}

cmd_backup() {   # backup [метка] — pg_dump в каталог с манифестом; печатает путь
  load_env
  local label="${1:-manual}" ts dir rev
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  dir="$BACKUPS/$ts-$label"
  mkdir -p "$dir"
  dc exec -T postgres pg_dump -U mfagate -d mfagate -Fc > "$dir/db.dump" || { rm -rf "$dir"; die "pg_dump не выполнен (postgres запущен?)"; }
  rev="$(dc exec -T postgres psql -U mfagate -d mfagate -tAc 'SELECT version_num FROM alembic_version' 2>/dev/null || echo unknown)"
  ( cd "$dir" && sha256sum db.dump > SHA256SUMS )
  printf 'version=%s\nschema=%s\ncreated=%s\nmaster_key_sha256=%s\n' "$MFA_GATE_VERSION" "$rev" "$ts" \
    "$(sha256sum "$DATA/secrets/master.key" | cut -c1-16)" > "$dir/manifest"
  chmod -R go-rwx "$dir"
  # shortcut: мастер-ключ в копию не кладётся (храните отдельно); при необходимости шифрованного комплекта — добавить gpg/age
  echo "$dir"
}

cmd_restore() {   # restore <каталог копии>
  load_env
  local dir="${1:?укажите каталог резервной копии}"
  [[ -f "$dir/db.dump" && -f "$dir/manifest" ]] || die "$dir не похож на резервную копию MFA Gate"
  ( cd "$dir" && sha256sum -c --quiet SHA256SUMS ) || die "контрольная сумма копии не совпала"
  local key_now key_then
  key_now="$(sha256sum "$DATA/secrets/master.key" | cut -c1-16)"
  key_then="$(grep '^master_key_sha256=' "$dir/manifest" | cut -d= -f2)"
  [[ "$key_now" == "$key_then" ]] || die "копия сделана с другим мастер-ключом: верните прежний data/secrets/master.key"
  say "остановка api/radius/worker"
  dc stop api radius worker
  say "восстановление базы из $dir"
  dc exec -T postgres psql -U mfagate -d postgres -qc 'DROP DATABASE IF EXISTS mfa_gate_restore' >/dev/null
  dc exec -T postgres psql -U mfagate -d postgres -qc 'CREATE DATABASE mfa_gate_restore' >/dev/null
  dc exec -T postgres pg_restore -U mfagate -d mfa_gate_restore --no-owner < "$dir/db.dump" || die "pg_restore не выполнен, рабочая база не тронута"
  # подмена базы по имени: прежняя остаётся как mfa_gate_prev до следующего restore
  dc exec -T postgres psql -U mfagate -d postgres -qc \
    "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='mfagate' AND pid<>pg_backend_pid();" >/dev/null
  dc exec -T postgres psql -U mfagate -d postgres -qc 'DROP DATABASE IF EXISTS mfa_gate_prev' >/dev/null
  dc exec -T postgres psql -U mfagate -d postgres -qc 'ALTER DATABASE mfagate RENAME TO mfa_gate_prev' >/dev/null
  dc exec -T postgres psql -U mfagate -d postgres -qc 'ALTER DATABASE mfa_gate_restore RENAME TO mfagate' >/dev/null
  dc up -d
  wait_healthy 180 || die "после восстановления сервисы не стали healthy: ./mfagatectl logs"
  say "восстановлено; прежняя база сохранена как mfa_gate_prev"
}

cmd_update() {   # update <версия>
  load_env
  local target="${1:?укажите версию, например ./mfagatectl update 0.2.0}" previous="$MFA_GATE_VERSION" backup
  valid_version "$target"
  say "обновление $previous → $target"
  say "резервная копия перед обновлением"
  backup="$(cmd_backup "pre-$target" | tail -n1)"
  printf 'previous=%s\nbackup=%s\n' "$previous" "$backup" > "$BACKUPS/last-update"
  set_env MFA_GATE_VERSION "$target"
  load_env
  if ! (ensure_image); then
    set_env MFA_GATE_VERSION "$previous"
    die "образ $MFA_GATE_IMAGE:$target недоступен — версия осталась $previous, система не менялась"
  fi
  dc up -d --remove-orphans || { warn "запуск новой версии не удался — откат"; cmd_rollback; die "обновление отменено"; }
  if ! wait_healthy 180; then
    warn "новая версия не стала healthy — откат на $previous"
    cmd_rollback
    die "обновление отменено, система на версии $previous"
  fi
  say "обновлено до $target (копия перед обновлением: $backup)"
}

cmd_rollback() {   # возврат к версии и копии из последнего update
  load_env
  [[ -f "$BACKUPS/last-update" ]] || die "нет сведений о последнем обновлении ($BACKUPS/last-update)"
  local previous backup
  previous="$(grep '^previous=' "$BACKUPS/last-update" | cut -d= -f2)"
  backup="$(grep '^backup=' "$BACKUPS/last-update" | cut -d= -f2)"
  say "откат на $previous с восстановлением $backup (миграции вперёд необратимы — база возвращается из копии)"
  set_env MFA_GATE_VERSION "$previous"
  load_env
  ensure_image
  dc up -d --no-deps postgres
  cmd_restore "$backup"
}

cmd_check_update() {
  load_env
  [[ "$MFA_GATE_REPO" == OWNER/* ]] && die "задайте MFA_GATE_REPO в .env"
  local latest
  latest="$(curl -fsSL "https://api.github.com/repos/$MFA_GATE_REPO/releases/latest" | sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' | head -n1)"
  [[ -n "$latest" ]] || die "не удалось получить список выпусков $MFA_GATE_REPO"
  if [[ "$latest" == "$MFA_GATE_VERSION" ]]; then say "установлена последняя версия $latest"; else say "доступна версия $latest (установлена $MFA_GATE_VERSION): ./mfagatectl update $latest"; fi
}

cmd_diagnose() {   # сводка в терминал + архив для поддержки без секретов
  load_env
  local ts out tmp
  ts="$(date -u +%Y%m%dT%H%M%SZ)"; tmp="$(mktemp -d)"; out="$BACKUPS/diag-$ts.tar.gz"
  {
    echo "== версия"; echo "mfagate $MFA_GATE_VERSION ($MFA_GATE_IMAGE)"; docker version --format 'docker {{.Server.Version}}'; docker compose version
    echo "== контейнеры"; dc ps --format 'table {{.Service}}\t{{.Status}}'
    echo "== проверки приложения"; dc exec -T api python -m mfa_gate diagnose || true
    echo "== готовность HTTP"; curl -fsS "http://127.0.0.1:$MFA_GATE_HTTP_PORT/health/ready" || echo "недоступно"
    echo; echo "== публичный адрес"; curl -fsSI --max-time 5 "$MFA_GATE_PUBLIC_URL/health/live" | head -n1 || echo "недоступен с этого хоста: $MFA_GATE_PUBLIC_URL"
    echo "== диск"; df -h "$DATA" | tail -n1; du -sh "$DATA/postgres" 2>/dev/null || true
    echo "== резервные копии"; ls -1t "$BACKUPS" | grep -v '^diag-' | head -n5 || true
  } 2>&1 | tee "$tmp/summary.txt"
  for svc in api radius worker migrate postgres; do dc logs --no-color --tail 300 "$svc" > "$tmp/$svc.log" 2>&1 || true; done
  sed -E 's/^([A-Z_]*(PASSWORD|SECRET|KEY)[A-Z_]*)=.*/\1=***/' "$ENV_FILE" > "$tmp/env.masked"
  # защита от утечки: значения секретов не должны встречаться ни в одном файле архива
  local secret
  for secret in "$POSTGRES_PASSWORD" "$(cat "$DATA/secrets/master.key")"; do
    if [[ -n "$secret" ]] && grep -rqF -- "$secret" "$tmp"; then rm -rf "$tmp"; die "в диагностике найден секрет — архив не создан"; fi
  done
  tar -C "$tmp" -czf "$out" . && rm -rf "$tmp" && chmod 600 "$out"
  say "архив для поддержки: $out"
}

cmd_admin_init() {   # первый главный администратор с временным паролем; пароль печатается один раз и не пишется в журналы
  load_env
  dc exec -T api python -m mfa_gate create-admin admin --name "Администратор" --temporary --if-no-admin
}

cmd_uninstall() {   # uninstall [--purge] — остановить и удалить контейнеры; с --purge — и данные (база, мастер-ключ, копии)
  load_env
  if [[ "${1:-}" == --purge ]]; then
    read -r -p "Удалить ВСЕ данные MFA Gate ($DATA, $BACKUPS) без возможности восстановления? Введите DELETE: " answer
    [[ "$answer" == DELETE ]] || die "отменено"
    dc down -v --remove-orphans
    docker run --rm -v "$DATA:/d" -v "$BACKUPS:/b" alpine:3 sh -c 'rm -rf /d/* /b/*' >/dev/null 2>&1 || true
    rm -f "$ENV_FILE"
    say "MFA Gate удалён вместе с данными"
  else
    dc down --remove-orphans
    say "контейнеры удалены; данные сохранены в $DATA и $BACKUPS — повторный ./mfagatectl install вернёт систему"
  fi
}

usage() {
  cat <<'EOF'
Использование: ./mfagatectl <команда>
  install                 первая установка или повторная (идемпотентно)
  start | stop            запуск / остановка всех сервисов
  restart [сервис]        перезапуск (api, radius, worker, postgres)
  status                  состояние контейнеров и версия
  logs [сервис]           журналы (последние 200 строк, -f для слежения: logs api -f)
  update <версия>         копия → новая версия → миграции → проверка → откат при сбое
  rollback                вернуть версию и базу до последнего update
  check-update            проверить новую версию на GitHub
  backup                  резервная копия базы в MFA_GATE_BACKUPS
  restore <каталог>       восстановить базу из копии
  diagnose                проверка и архив для поддержки без секретов
  admin <логин>           создать/восстановить главного администратора (пароль печатается один раз)
  emergency <логин>       одноразовый аварийный код вместо второго фактора (журналируется)
  radius-test <логин>     тестовый Access-Request к своему RADIUS (спросит секрет и пароль)
  admin-init              первый администратор admin с временным паролем (если администратора ещё нет)
  uninstall [--purge]     удалить контейнеры (данные сохраняются); --purge — удалить и данные
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    install) cmd_install ;;
    start) load_env; dc up -d; wait_healthy 120 && say "запущено" ;;
    stop) load_env; dc stop ;;
    restart) load_env; dc restart "$@" ;;
    status) cmd_status ;;
    logs) load_env; dc logs --tail 200 "$@" ;;
    update) cmd_update "$@" ;;
    rollback) cmd_rollback ;;
    check-update) cmd_check_update ;;
    backup) cmd_backup "${1:-manual}" ;;
    restore) cmd_restore "$@" ;;
    diagnose) cmd_diagnose ;;
    admin) load_env; dc exec api python -m mfa_gate create-admin "${1:?укажите логин}" ;;
    emergency) load_env; dc exec api python -m mfa_gate emergency-access "${1:?укажите логин}" ;;
    radius-test) load_env; dc exec api python -m mfa_gate radius-test --host radius --port 1812 --user "${1:?укажите логин}" ;;
    admin-init) cmd_admin_init ;;
    uninstall) cmd_uninstall "$@" ;;
    help|-h|--help) usage ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
