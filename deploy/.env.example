# Конфигурация экземпляра MFA Gate. ./mfagatectl install создаёт .env из этого файла и генерирует секреты.
# Файл .env содержит пароль БД — права 600, в Git не попадает.

# Имя экземпляра: префикс контейнеров, сетей и томов. Разные экземпляры на одном хосте — разные имена.
COMPOSE_PROJECT_NAME=mfa-gate

# Образ и ЗАФИКСИРОВАННАЯ версия (не latest). Локальная сборка: MFA_GATE_IMAGE=mfa-gate
MFA_GATE_IMAGE=ghcr.io/calleograph/mfa-gate
MFA_GATE_VERSION=0.2.0
# Репозиторий для проверки новых версий (owner/name на GitHub)
MFA_GATE_REPO=calleograph/mfa-gate

# Каталог постоянных данных (БД, мастер-ключ). Резервные копии — в MFA_GATE_BACKUPS.
MFA_GATE_DATA=./data
MFA_GATE_BACKUPS=./backups

# Адрес, по которому телефоны и администраторы обращаются к серверу (install.sh подставит http://IP:порт; позже — https:// reverse proxy)
MFA_GATE_PUBLIC_URL=http://192.0.2.10:8080
MFA_GATE_SERVER_NAME=MFA Gate

# HTTP API и панель. All-in-One: 0.0.0.0 — панель сразу открывается по http://IP:порт (только изолированная сеть!).
# За reverse proxy с TLS поставьте 127.0.0.1 и задайте MFA_GATE_PUBLIC_URL=https://…
MFA_GATE_HTTP_BIND=0.0.0.0
MFA_GATE_HTTP_PORT=8080
# RADIUS: адрес, на котором его увидят VPN-шлюзы (0.0.0.0 — все интерфейсы; ограничьте firewall'ом)
MFA_GATE_RADIUS_BIND=0.0.0.0
MFA_GATE_RADIUS_PORT=1812

# Секунд на ответ push. На шлюзе RADIUS-таймаут должен быть больше (рекомендуется >= 60)
MFA_GATE_PUSH_TIMEOUT=45
# Адреса reverse proxy, от которых принимается X-Forwarded-For
MFA_GATE_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12
MFA_GATE_COOKIE_SECURE=auto
MFA_GATE_LOG_LEVEL=INFO

# Push через FCM: путь к service account JSON ВНУТРИ контейнера (положите файл в data/secrets и смонтируйте, см. docs/push.md)
MFA_GATE_PUSH_FCM_CREDENTIALS_FILE=
# UnifiedPush: разрешённые хосты распределителей через запятую (например, ваш ntfy)
MFA_GATE_PUSH_UNIFIEDPUSH_HOSTS=

# Генерируется установщиком
POSTGRES_PASSWORD=
